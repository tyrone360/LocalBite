
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <!-- HERO WITH SLIDESHOW -->
    <section class="privacy-hero">

        <div class="privacy-hero-content">
            <span class="privacy-label">LOCALBITE · YOUR PRIVACY</span>
            <h1>Your privacy matters<span>.</span></h1>
            <p>
                We respect your privacy and aim to handle your personal
                information responsibly whenever you use LocalBite.
            </p>
            <a href="#privacy-details" class="privacy-hero-link">
                Learn about your privacy →
            </a>
        </div>

        <div class="privacy-slideshow">

            <div class="privacy-slide active">
                <img src="~/images/about/restaurant-hero.jpg"
                     alt="LocalBite dining experience" />
            </div>

            <div class="privacy-slide">
                <img src="~/images/about/restaurant-interior.jpg"
                     alt="Restaurant interior" />
            </div>

            <div class="privacy-slide">
                <img src="~/images/about/grilled-food.jpg"
                     alt="Food prepared for customers" />
            </div>

            <button class="privacy-slide-arrow prev" type="button"
                    aria-label="Previous slide">&#10094;</button>

            <button class="privacy-slide-arrow next" type="button"
                    aria-label="Next slide">&#10095;</button>

            <div class="privacy-slide-dots">
                <button class="privacy-dot active" type="button" aria-label="Show slide 1"></button>
                <button class="privacy-dot" type="button" aria-label="Show slide 2"></button>
                <button class="privacy-dot" type="button" aria-label="Show slide 3"></button>
            </div>

            <div class="privacy-image-caption">
                <span>LOCALBITE</span>
                <strong>Your experience matters.</strong>
            </div>

        </div>
    </section>

    <!-- PRIVACY CONTENT -->
    <section class="privacy-content" id="privacy-details">

        <div class="privacy-card">
            <span class="privacy-number">01</span>
            <h2>Information We Collect</h2>
            <p>
                When you create an account or place an order, LocalBite
                may collect information such as:
            </p>
            <ul>
                <li>Your name and email address.</li>
                <li>Your phone number.</li>
                <li>Your delivery address.</li>
                <li>Your profile photo, if you upload one.</li>
                <li>Your order details, including items and payment method.</li>
            </ul>
        </div>

        <div class="privacy-card">
            <span class="privacy-number">02</span>
            <h2>How We Use Your Information</h2>
            <p>We use your information to:</p>
            <ul>
                <li>Create and manage your LocalBite account.</li>
                <li>Process and manage your food orders.</li>
                <li>Communicate with you about your orders.</li>
                <li>Display your account and order history.</li>
                <li>Improve the LocalBite experience.</li>
            </ul>
        </div>

        <div class="privacy-card">
            <span class="privacy-number">03</span>
            <h2>Payments</h2>
            <p>
                LocalBite currently supports Cash on Delivery and EFT.
                Payment information should only be provided through
                the payment instructions presented by the restaurant.
                Do not share your banking passwords or PINs.
            </p>
        </div>

        <div class="privacy-card">
            <span class="privacy-number">04</span>
            <h2>Protecting Your Information</h2>
            <p>
                We take reasonable steps to protect the information
                stored in LocalBite. However, no online platform can
                guarantee complete security.
            </p>
        </div>

        <div class="privacy-card">
            <span class="privacy-number">05</span>
            <h2>Sharing Information</h2>
            <p>
                Information necessary to prepare and deliver your order
                may be accessed by authorised people responsible for
                managing LocalBite orders.
            </p>
        </div>

        <div class="privacy-card">
            <span class="privacy-number">06</span>
            <h2>Your Choices</h2>
            <p>
                You can access your account profile and update
                information where those features are available.
                You may also contact the LocalBite team with questions
                about your personal information.
            </p>
        </div>

        <div class="privacy-card">
            <span class="privacy-number">07</span>
            <h2>Changes to This Policy</h2>
            <p>
                This Privacy Policy may be updated as LocalBite
                develops. Any updated version will be published
                on this page.
            </p>
        </div>

    </section>

    <!-- FOOTER -->
    <div class="privacy-footer-note">
        <span>LOCALBITE<span class="gold-dot">.</span></span>
        <p>Good food. Good mood. Your privacy matters.</p>
    </div>

</div>

<style>
    .privacy-page {
        max-width: 1150px;
        margin: 40px auto;
        color: #24364b;
    }

    .privacy-page * {
        box-sizing: border-box;
    }

    .privacy-hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 30px;
        padding: 30px;
        border: 1px solid rgba(255,255,255,.8);
        border-radius: 32px;
        background: rgba(255,255,255,.62);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: 0 18px 50px rgba(45,80,120,.09);
    }

    .privacy-hero-content {
        padding: 20px;
    }

    .privacy-label {
        color: #a87920;
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: 3px;
    }

    .privacy-hero h1 {
        margin: 20px 0;
        font-size: clamp(2.3rem, 5vw, 4rem);
        font-weight: 900;
        letter-spacing: -2px;
    }

    .privacy-hero h1 span,
    .gold-dot {
        color: #d3a64e;
    }

    .privacy-hero-content p {
        color: #64758a;
        line-height: 1.9;
    }

    .privacy-hero-link {
        display: inline-block;
        margin-top: 18px;
        color: #287fc0;
        font-weight: 800;
        text-decoration: none;
    }

    /* SLIDESHOW */

    .privacy-slideshow {
        position: relative;
        min-height: 340px;
        overflow: hidden;
        border-radius: 25px;
        background: #dce6ef;
    }

    .privacy-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: opacity 1s ease, visibility 1s ease;
    }

    .privacy-slide.active {
        opacity: 1;
        visibility: visible;
    }

    .privacy-slide img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transform: scale(1.04);
        transition: transform 5s ease;
    }

    .privacy-slide.active img {
        transform: scale(1.12);
    }

    .privacy-slide-arrow {
        position: absolute;
        z-index: 3;
        top: 50%;
        width: 42px;
        height: 42px;
        border: 1px solid rgba(255,255,255,.6);
        border-radius: 50%;
        color: white;
        background: rgba(20,35,50,.45);
        backdrop-filter: blur(10px);
        cursor: pointer;
        transform: translateY(-50%);
        transition: .25s ease;
    }

    .privacy-slide-arrow:hover {
        background: rgba(35,108,174,.85);
        transform: translateY(-50%) scale(1.08);
    }

    .privacy-slide-arrow.prev {
        left: 14px;
    }

    .privacy-slide-arrow.next {
        right: 14px;
    }

    .privacy-slide-dots {
        position: absolute;
        z-index: 4;
        bottom: 115px;
        left: 50%;
        display: flex;
        gap: 8px;
        transform: translateX(-50%);
    }

    .privacy-dot {
        width: 9px;
        height: 9px;
        padding: 0;
        border: 0;
        border-radius: 20px;
        background: rgba(255,255,255,.65);
        cursor: pointer;
        transition: .3s ease;
    }

    .privacy-dot.active {
        width: 25px;
        background: #f2ce7f;
    }

    .privacy-image-caption {
        position: absolute;
        z-index: 2;
        right: 16px;
        bottom: 16px;
        left: 16px;
        padding: 18px;
        border: 1px solid rgba(255,255,255,.4);
        border-radius: 18px;
        color: white;
        background: rgba(20,35,50,.55);
        backdrop-filter: blur(15px);
    }

    .privacy-image-caption span,
    .privacy-image-caption strong {
        display: block;
    }

    .privacy-image-caption span {
        font-size: .7rem;
        letter-spacing: 2px;
    }

    .privacy-image-caption strong {
        margin-top: 5px;
        font-size: 1.15rem;
    }

    /* PRIVACY CARDS */

    .privacy-content {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-top: 28px;
    }

    .privacy-card {
        position: relative;
        padding: 30px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.8);
        border-radius: 24px;
        background: rgba(255,255,255,.62);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 12px 35px rgba(45,80,120,.07);
        transition: transform .3s ease, box-shadow .3s ease;
    }

    .privacy-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 18px 40px rgba(45,80,120,.12);
    }

    .privacy-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        margin-bottom: 15px;
        border-radius: 13px;
        color: #a87920;
        background: linear-gradient(135deg,#fff3d7,#fff);
        font-weight: 900;
        font-size: .85rem;
    }

    .privacy-card h2 {
        margin-bottom: 15px;
        color: #287fc0;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .privacy-card p,
    .privacy-card li {
        color: #627187;
        font-size: .94rem;
        line-height: 1.8;
    }

    .privacy-card ul {
        padding-left: 20px;
        margin-bottom: 0;
    }

    .privacy-footer-note {
        padding: 35px 15px;
        text-align: center;
    }

    .privacy-footer-note > span {
        font-size: 1.4rem;
        font-weight: 900;
        letter-spacing: -1px;
    }

    .privacy-footer-note p {
        margin-top: 8px;
        color: #718096;
    }

    @@media (max-width: 850px) {
        .privacy-hero {
            grid-template-columns: 1fr;
        }

        .privacy-slideshow {
            min-height: 300px;
        }
    }

    @@media (max-width: 700px) {
        .privacy-page {
            margin: 25px auto;
        }

        .privacy-hero {
            padding: 20px;
        }

        .privacy-hero-content {
            padding: 12px;
        }

        .privacy-content {
            grid-template-columns: 1fr;
        }

        .privacy-card {
            padding: 23px;
        }
    }
</style>

<script>
    (() => {
        const slideshow = document.querySelector(".privacy-slideshow");

        if (!slideshow) return;

        const slides = [...slideshow.querySelectorAll(".privacy-slide")];
        const dots = [...slideshow.querySelectorAll(".privacy-dot")];
        const previous = slideshow.querySelector(".privacy-slide-arrow.prev");
        const next = slideshow.querySelector(".privacy-slide-arrow.next");

        let current = 0;
        let timer;

        function showSlide(index) {
            current = (index + slides.length) % slides.length;

            slides.forEach((slide, i) => {
                slide.classList.toggle("active", i === current);
            });

            dots.forEach((dot, i) => {
                dot.classList.toggle("active", i === current);
            });
        }

        function startTimer() {
            clearInterval(timer);
            timer = setInterval(() => showSlide(current + 1), 5000);
        }

        previous.addEventListener("click", () => {
            showSlide(current - 1);
            startTimer();
        });

        next.addEventListener("click", () => {
            showSlide(current + 1);
            startTimer();
        });

        dots.forEach((dot, index) => {
            dot.addEventListener("click", () => {
                showSlide(index);
                startTimer();
            });
        });

        slideshow.addEventListener("mouseenter", () => clearInterval(timer));
        slideshow.addEventListener("mouseleave", startTimer);

        showSlide(0);
        startTimer();
    })();
</script>
