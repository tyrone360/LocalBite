
@model ErrorViewModel
@inject IWebHostEnvironment Environment

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="error-page">
    <div class="error-card">

        <div class="error-icon">
            <span>!</span>
        </div>

        <p class="error-eyebrow">LOCALBITE • SYSTEM NOTICE</p>

        <h1>Oops! Something went wrong.</h1>

        <p class="error-description">
            We couldn't complete your request right now.
            Don't worry — your food journey doesn't have to end here.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="request-id">
                <span>REFERENCE NUMBER</span>
                <code>@Model.RequestId</code>
            </div>
        }

        <a asp-controller="Home"
           asp-action="Index"
           class="error-home-button">
            <span>Back to Home</span>
            <span class="button-arrow">→</span>
        </a>

        <p class="error-help">
            If this keeps happening, please try again later.
        </p>

        @if (Environment.IsDevelopment())
        {
            <div class="development-note">
                <strong>Development mode</strong>
                <p>
                    Detailed exception information is available in the
                    application logs. Never enable Development mode
                    on a deployed application.
                </p>
            </div>
        }

    </div>
</div>

<style>
    .error-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 55px 20px;
        position: relative;
        overflow: hidden;
    }

    .error-card {
        width: 100%;
        max-width: 620px;
        padding: 55px 45px;
        text-align: center;
        border-radius: 32px;
        background: rgba(255, 255, 255, 0.62);
        border: 1px solid rgba(255, 255, 255, 0.85);
        box-shadow: 0 25px 70px rgba(35, 65, 110, 0.10);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        animation: errorAppear 0.8s ease both;
    }

    .error-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 26px;
        background: linear-gradient(145deg, #e8efff, #fff2d9);
        box-shadow: 0 12px 30px rgba(47, 92, 160, 0.12);
    }

    .error-icon span {
        font-size: 43px;
        font-weight: 800;
        color: #2863b9;
    }

    .error-eyebrow {
        color: #bd963e;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 15px;
    }

    .error-card h1 {
        color: #17345e;
        font-size: clamp(29px, 5vw, 43px);
        font-weight: 800;
        letter-spacing: -1.5px;
        line-height: 1.15;
        margin-bottom: 18px;
    }

    .error-description {
        max-width: 440px;
        margin: 0 auto 28px;
        color: #64748b;
        font-size: 15px;
        line-height: 1.8;
    }

    .request-id {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 15px;
        margin: 0 auto 28px;
        max-width: 390px;
        border-radius: 16px;
        background: rgba(232, 239, 250, 0.65);
        border: 1px solid rgba(67, 111, 175, 0.12);
    }

    .request-id span {
        color: #8292a9;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .request-id code {
        color: #315f9e;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .error-home-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding: 15px 25px;
        border-radius: 50px;
        background: linear-gradient(120deg, #2464bd, #174783);
        color: white !important;
        text-decoration: none !important;
        font-weight: 700;
        box-shadow: 0 10px 25px rgba(36, 100, 189, 0.22);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .error-home-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(36, 100, 189, 0.30);
    }

    .button-arrow {
        color: #f4d58a;
        font-size: 20px;
    }

    .error-help {
        margin-top: 25px;
        color: #91a0b3;
        font-size: 12px;
    }

    .development-note {
        margin-top: 30px;
        padding: 15px;
        text-align: left;
        border-radius: 14px;
        background: rgba(255, 245, 220, 0.7);
        color: #80652d;
        font-size: 12px;
        line-height: 1.6;
    }

    .development-note p {
        margin: 6px 0 0;
    }

    @@keyframes errorAppear {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 600px) {
        .error-page {
            padding: 35px 14px;
        }

        .error-card {
            padding: 40px 22px;
            border-radius: 25px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .error-card {
            animation: none;
        }

        .error-home-button {
            transition: none;
        }
    }
</style>
