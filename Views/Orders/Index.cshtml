
@model IEnumerable<LocalBite.Models.Order>

@{
    ViewData["Title"] = "My Orders";

    var statusSteps = new[]
    {
        "Placed",
        "Accepted",
        "Preparing",
        "Ready for delivery",
        "Out for delivery",
        "Delivered"
    };
}

<div class="container py-5 orders-page">

    <section class="orders-heading mb-5">
        <span class="orders-eyebrow">YOUR LOCALBITE ACTIVITY</span>
        <h1>Track your <span>Orders.</span></h1>
        <p>Follow your food from our kitchen to your doorstep.</p>
    </section>

    @if (Model == null || !Model.Any())
    {
        <section class="orders-empty">
            <div class="orders-empty-icon">LB</div>
            <span class="orders-eyebrow">NOTHING HERE YET</span>
            <h2>Your food journey starts here.</h2>
            <p>
                You haven't placed any orders yet.
                Explore our menu and discover your next favourite meal.
            </p>
            <a asp-controller="Menu" asp-action="Index" class="btn btn-warning mt-3">
                Explore Menu →
            </a>
        </section>
    }
    else
    {
        @foreach (var order in Model)
        {
            var currentStep = Array.FindIndex(
                statusSteps,
                step => string.Equals(
                    step,
                    order.OrderStatus,
                    StringComparison.OrdinalIgnoreCase));

            var isCancelled = string.Equals(
                order.OrderStatus,
                "Cancelled",
                StringComparison.OrdinalIgnoreCase);

            <article class="order-tracking-card mb-5">

                <div class="tracking-header">
                    <div>
                        <span class="orders-eyebrow">ORDER NUMBER</span>
                        <h2>#@order.Id</h2>
                        <p>
                            Placed @order.CreatedAt.ToLocalTime()
                                .ToString("dd MMM yyyy · HH:mm")
                        </p>
                    </div>

                    <span class="order-status">
                        @order.OrderStatus
                    </span>
                </div>

                <div class="tracking-map-heading">
                    <div>
                        <span class="orders-eyebrow">DELIVERY TRACKING</span>
                        <h3>Your food is on its journey.</h3>
                    </div>
                    <span class="demo-label">
                        <span class="demo-dot"></span>
                        DEMO MODE
                    </span>
                </div>

                <div class="delivery-map"
                     id="delivery-map-@order.Id"
                     data-delivery-started="@(currentStep >= 4 ? "true" : "false")"
                     data-delivered="@(currentStep == 5 ? "true" : "false")"
                     data-cancelled="@(isCancelled ? "true" : "false")"
                     aria-label="Simulated delivery route map">
                </div>

                <div class="map-legend">
                    <span><i class="legend-dot restaurant-dot"></i> Restaurant</span>
                    <span><i class="legend-dot rider-dot"></i> Delivery rider</span>
                    <span><i class="legend-dot destination-dot"></i> Destination</span>
                </div>

                <div class="delivery-info">
                    <div class="delivery-info-icon">🚴</div>
                    <div class="delivery-info-text">
                        <strong class="delivery-message"
                                data-delivery-message="@order.Id">
                            @if (isCancelled)
                            {
                                @:This order was cancelled.
                            }
                            else if (currentStep < 4)
                            {
                                @:Your rider is waiting for dispatch.
                            }
                            else if (currentStep == 4)
                            {
                                @:Your rider is on the way!
                            }
                            else
                            {
                                @:Your delivery has arrived!
                            }
                        </strong>

                        <span class="delivery-estimate"
                              data-delivery-estimate="@order.Id">
                            @if (isCancelled)
                            {
                                @:No delivery scheduled.
                            }
                            else if (currentStep < 4)
                            {
                                @:The journey begins when your order is out for delivery.
                            }
                            else if (currentStep == 5)
                            {
                                @:Your order has reached its destination.
                            }
                            else
                            {
                                @:Demo journey: approximately 3 minutes.
                            }
                        </span>
                    </div>

                    @if (!isCancelled && currentStep >= 4)
                    {
                        <button type="button"
                                class="replay-button"
                                data-replay-map="@order.Id">
                            Replay route ↻
                        </button>
                    }
                </div>

                <p class="demo-disclaimer">
                    This is a simulated route for demonstration purposes.
                    The rider's position and estimated arrival time are not live.
                </p>

                <div class="tracking-timeline">
                    <div class="timeline-heading">
                        <div>
                            <span class="orders-eyebrow">ORDER PROGRESS</span>
                            <h3>Delivery journey</h3>
                        </div>
                        <span class="timeline-current">
                            @(isCancelled ? "Cancelled" :
                                currentStep >= 0 ? $"{currentStep + 1} of {statusSteps.Length}" : "Pending update")
                        </span>
                    </div>

                    @if (isCancelled)
                    {
                        <div class="cancelled-message">
                            This order has been cancelled.
                        </div>
                    }
                    else
                    {
                        <div class="timeline-steps">
                            @for (var i = 0; i < statusSteps.Length; i++)
                            {
                                var stepIndex = i;
                                var completed = currentStep >= 0 && stepIndex <= currentStep;
                                var active = currentStep == stepIndex;

                                <div class="timeline-step @(completed ? "completed" : "") @(active ? "active" : "")">
                                    <div class="timeline-marker">
                                        @if (completed)
                                        {
                                            <span>✓</span>
                                        }
                                        else
                                        {
                                            <span>@(stepIndex + 1)</span>
                                        }
                                    </div>
                                    <span class="timeline-step-label">
                                        @statusSteps[stepIndex]
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="order-items-section">
                    <span class="orders-eyebrow">YOUR ORDER</span>

                    @foreach (var item in order.OrderItems)
                    {
                        <div class="order-item">
                            <div>
                                <strong>@(item.MenuItem?.Name ?? "Menu item")</strong>
                                <small>Quantity: @item.Quantity</small>
                            </div>
                            <strong>
                                @((item.UnitPrice * item.Quantity).ToString(
                                    "C2",
                                    System.Globalization.CultureInfo.GetCultureInfo("en-ZA")))
                            </strong>
                        </div>
                    }
                </div>

                <div class="order-card-footer">
                    <div>
                        <small>PAYMENT METHOD</small>
                        <strong>@order.PaymentMethod</strong>
                    </div>

                    <div class="order-total">
                        <small>ORDER TOTAL</small>
                        <strong>
                            @order.TotalAmount.ToString(
                                "C2",
                                System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                        </strong>
                    </div>
                </div>

            </article>
        }
    }

    <div class="orders-back-link mt-4">
        <a asp-controller="Dashboard" asp-action="Index">
            ← Back to Dashboard
        </a>
    </div>

</div>

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<style>
    .orders-page {
        min-height: 65vh;
    }

    .orders-heading,
    .order-tracking-card,
    .orders-empty {
        background: rgba(255,255,255,.64);
        border: 1px solid rgba(255,255,255,.9);
        box-shadow: 0 18px 45px rgba(55,105,145,.09);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
    }

    .orders-heading {
        padding: 35px;
        border-radius: 28px;
        background: linear-gradient(135deg, rgba(255,255,255,.88), rgba(220,239,255,.72));
    }

    .orders-eyebrow {
        color: #347fc1;
        font-size: .7rem;
        font-weight: 850;
        letter-spacing: 1.8px;
    }

    .orders-heading h1 {
        margin-top: 12px;
        font-size: clamp(2.5rem, 5vw, 3.8rem);
        font-weight: 850;
        letter-spacing: -2px;
        color: #203247;
    }

    .orders-heading h1 span {
        color: #347fc1;
    }

    .orders-heading p,
    .tracking-header p {
        color: #718399;
        margin-bottom: 0;
    }

    .order-tracking-card {
        overflow: hidden;
        padding: 28px;
        border-radius: 28px;
    }

    .tracking-header,
    .tracking-map-heading,
    .timeline-heading,
    .order-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .tracking-header h2 {
        color: #203247;
        font-size: 2rem;
        font-weight: 850;
        margin: 5px 0;
    }

    .tracking-header p {
        font-size: .85rem;
    }

    .order-status {
        padding: 9px 15px;
        border-radius: 30px;
        color: #347fc1;
        background: rgba(105,185,244,.15);
        font-size: .8rem;
        font-weight: 750;
    }

    .tracking-map-heading {
        margin: 30px 0 15px;
    }

    .tracking-map-heading h3,
    .timeline-heading h3 {
        color: #203247;
        font-size: 1.25rem;
        font-weight: 850;
        margin: 5px 0 0;
    }

    .demo-label {
        color: #347fc1;
        font-size: .68rem;
        font-weight: 850;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    .demo-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        margin-right: 5px;
        border-radius: 50%;
        background: #36b77b;
        box-shadow: 0 0 10px rgba(54,183,123,.65);
    }

    .delivery-map {
        height: 350px;
        width: 100%;
        overflow: hidden;
        border-radius: 22px;
        border: 1px solid rgba(130,170,205,.25);
        background: #e8f0f5;
        z-index: 1;
    }

    .map-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        padding: 15px 4px;
        color: #718399;
        font-size: .78rem;
        font-weight: 650;
    }

    .legend-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        margin-right: 5px;
        border-radius: 50%;
    }

    .restaurant-dot { background: #347fc1; }
    .rider-dot { background: #e4a52f; }
    .destination-dot { background: #25a875; }

    .delivery-info {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px;
        border-radius: 18px;
        background: linear-gradient(110deg, rgba(220,239,255,.7), rgba(255,244,219,.65));
        border: 1px solid rgba(255,255,255,.9);
    }

    .delivery-info-icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 15px;
        background: rgba(255,255,255,.8);
        font-size: 1.5rem;
    }

    .delivery-info-text {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
    }

    .delivery-info-text strong {
        color: #203247;
        font-size: .92rem;
    }

    .delivery-info-text span {
        color: #718399;
        font-size: .78rem;
    }

    .replay-button {
        border: 1px solid rgba(52,127,193,.25);
        background: rgba(255,255,255,.75);
        color: #347fc1;
        border-radius: 30px;
        padding: 9px 14px;
        font-size: .76rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .replay-button:hover {
        background: #347fc1;
        color: white;
    }

    .demo-disclaimer {
        margin: 10px 2px 0;
        color: #8797a8;
        font-size: .72rem;
    }

    .tracking-timeline {
        margin-top: 32px;
        padding: 25px 0;
        border-top: 1px solid rgba(117,159,193,.2);
        border-bottom: 1px solid rgba(117,159,193,.2);
    }

    .timeline-current {
        color: #347fc1;
        font-size: .78rem;
        font-weight: 800;
    }

    .timeline-steps {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 8px;
        margin-top: 28px;
    }

    .timeline-step {
        position: relative;
        display: flex;
        align-items: center;
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }

    .timeline-marker {
        display: grid;
        place-items: center;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #edf2f6;
        color: #8a9bad;
        border: 2px solid #dce5ec;
        font-size: .8rem;
        font-weight: 850;
        z-index: 1;
    }

    .timeline-step.completed .timeline-marker {
        background: #347fc1;
        border-color: #347fc1;
        color: white;
    }

    .timeline-step.active .timeline-marker {
        box-shadow: 0 0 0 6px rgba(52,127,193,.13);
    }

    .timeline-step-label {
        color: #8191a2;
        font-size: .68rem;
        font-weight: 650;
        line-height: 1.4;
    }

    .timeline-step.completed .timeline-step-label {
        color: #347fc1;
    }

    .cancelled-message {
        margin-top: 20px;
        padding: 14px;
        border-radius: 12px;
        background: rgba(220,70,70,.08);
        color: #b54b4b;
        font-weight: 700;
    }

    .order-items-section {
        padding: 24px 0 15px;
    }

    .order-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 12px 0;
        color: #344d65;
        border-bottom: 1px solid rgba(117,159,193,.12);
    }

    .order-item div {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .order-item small {
        color: #718399;
        font-size: .78rem;
    }

    .order-card-footer {
        padding-top: 18px;
    }

    .order-card-footer small {
        display: block;
        margin-bottom: 6px;
        color: #718399;
        font-size: .68rem;
        font-weight: 750;
        letter-spacing: 1px;
    }

    .order-card-footer strong {
        color: #203247;
    }

    .order-total {
        text-align: right;
    }

    .order-total strong {
        color: #347fc1;
        font-size: 1.25rem;
    }

    .orders-empty {
        text-align: center;
        padding: 65px 25px;
        border-radius: 28px;
    }

    .orders-empty-icon {
        display: grid;
        place-items: center;
        width: 85px;
        height: 85px;
        margin: 0 auto 25px;
        border-radius: 50%;
        color: #347fc1;
        font-size: 1.8rem;
        font-weight: 900;
        background: rgba(105,185,244,.13);
    }

    .orders-empty h2 {
        margin: 12px 0;
        color: #203247;
        font-weight: 850;
    }

    .orders-empty p {
        max-width: 450px;
        margin: 0 auto;
        color: #718399;
        line-height: 1.8;
    }

    .orders-back-link a {
        color: #347fc1;
        font-weight: 700;
        text-decoration: none;
    }

    .orders-back-link a:hover {
        color: #ad842f;
    }

    .rider-marker {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border: 3px solid white;
        border-radius: 50%;
        background: #e4a52f;
        box-shadow: 0 4px 16px rgba(0,0,0,.25);
        font-size: 19px;
    }

    .map-pin {
        width: 18px;
        height: 18px;
        border: 3px solid white;
        border-radius: 50%;
        box-shadow: 0 3px 10px rgba(0,0,0,.25);
    }

    .map-pin-start { background: #347fc1; }
    .map-pin-end { background: #25a875; }

    @@media (max-width: 700px) {
        .orders-heading {
            padding: 25px 20px;
        }

        .order-tracking-card {
            padding: 19px;
        }

        .delivery-map {
            height: 290px;
        }

        .timeline-steps {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            row-gap: 25px;
        }

        .delivery-info {
            flex-wrap: wrap;
        }

        .replay-button {
            margin-left: 62px;
        }
    }

    @@media (max-width: 420px) {
        .tracking-header,
        .tracking-map-heading,
        .timeline-heading {
            align-items: flex-start;
        }

        .tracking-map-heading {
            flex-direction: column;
        }

        .order-card-footer {
            align-items: flex-start;
        }
    }
</style>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin="">
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Fictional demonstration route in Johannesburg.
            const routeCoordinates = [
                [-26.2048, 28.0412],
                [-26.2037, 28.0450],
                [-26.2018, 28.0480],
                [-26.1994, 28.0502],
                [-26.1970, 28.0530],
                [-26.1948, 28.0560],
                [-26.1928, 28.0590]
            ];

            const maps = {};
            const DEMO_DURATION = 180000; // 3 minutes

            function createPin(className) {
                return L.divIcon({
                    className: "",
                    html: '<div class="map-pin ' + className + '"></div>',
                    iconSize: [18, 18],
                    iconAnchor: [9, 9]
                });
            }

            function interpolateRoute(points, progress) {
                const lengths = [];
                let totalLength = 0;

                for (let i = 0; i < points.length - 1; i++) {
                    const length = L.latLng(points[i])
                        .distanceTo(L.latLng(points[i + 1]));

                    lengths.push(length);
                    totalLength += length;
                }

                let remaining = totalLength * progress;

                for (let i = 0; i < lengths.length; i++) {
                    if (remaining <= lengths[i]) {
                        const fraction = remaining / lengths[i];

                        return L.latLng(
                            points[i][0] + (points[i + 1][0] - points[i][0]) * fraction,
                            points[i][1] + (points[i + 1][1] - points[i][1]) * fraction
                        );
                    }

                    remaining -= lengths[i];
                }

                return L.latLng(points[points.length - 1]);
            }

            function updateDeliveryText(mapData, progress) {
                const message = document.querySelector(
                    '[data-delivery-message="' + mapData.orderId + '"]'
                );

                const estimate = document.querySelector(
                    '[data-delivery-estimate="' + mapData.orderId + '"]'
                );

                if (!message || !estimate) return;

                if (progress >= 1) {
                    message.textContent = "Your delivery has arrived!";
                    estimate.textContent = "Your order has reached its destination.";
                    return;
                }

                message.textContent = "Your rider is on the way!";

                const remainingSeconds = Math.ceil(
                    (1 - progress) * DEMO_DURATION / 1000
                );

                const minutes = Math.floor(remainingSeconds / 60);
                const seconds = remainingSeconds % 60;

                estimate.textContent =
                    "Demo arrival in approximately " +
                    minutes + "m " + seconds + "s.";
            }

            function replayRoute(mapData) {
                cancelAnimationFrame(mapData.animationFrame);

                if (!mapData.started || mapData.cancelled) {
                    mapData.rider.setLatLng(routeCoordinates[0]);
                    mapData.progressLine.setLatLngs([]);
                    return;
                }

                if (mapData.delivered) {
                    mapData.rider.setLatLng(
                        routeCoordinates[routeCoordinates.length - 1]
                    );
                    mapData.progressLine.setLatLngs(routeCoordinates);
                    updateDeliveryText(mapData, 1);
                    return;
                }

                mapData.progressLine.setLatLngs([routeCoordinates[0]]);

                const startTime = performance.now();

                function animate(now) {
                    const progress = Math.min(
                        (now - startTime) / DEMO_DURATION,
                        1
                    );

                    const position = interpolateRoute(
                        routeCoordinates,
                        progress
                    );

                    mapData.rider.setLatLng(position);

                    const travelled = [];

                    for (let i = 0; i < routeCoordinates.length; i++) {
                        if (i / (routeCoordinates.length - 1) < progress) {
                            travelled.push(routeCoordinates[i]);
                        }
                    }

                    travelled.push(position);
                    mapData.progressLine.setLatLngs(travelled);

                    updateDeliveryText(mapData, progress);

                    if (progress < 1) {
                        mapData.animationFrame =
                            requestAnimationFrame(animate);
                    }
                }

                mapData.animationFrame =
                    requestAnimationFrame(animate);
            }

            document.querySelectorAll(".delivery-map").forEach(function (element) {

                const map = L.map(element, {
                    scrollWheelZoom: false
                }).setView(routeCoordinates[3], 14);

                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }).addTo(map);

                const route = L.polyline(routeCoordinates, {
                    color: "#347fc1",
                    weight: 6,
                    opacity: 0.85,
                    lineCap: "round"
                }).addTo(map);

                const progressLine = L.polyline([], {
                    color: "#e4a52f",
                    weight: 7,
                    opacity: 0.95,
                    lineCap: "round"
                }).addTo(map);

                L.marker(routeCoordinates[0], {
                    icon: createPin("map-pin-start")
                }).addTo(map).bindPopup("LocalBite Demo Kitchen");

                L.marker(routeCoordinates[routeCoordinates.length - 1], {
                    icon: createPin("map-pin-end")
                }).addTo(map).bindPopup("Demo delivery destination");

                const riderIcon = L.divIcon({
                    className: "",
                    html: '<div class="rider-marker">🚴</div>',
                    iconSize: [38, 38],
                    iconAnchor: [19, 19]
                });

                const started = element.dataset.deliveryStarted === "true";
                const delivered = element.dataset.delivered === "true";
                const cancelled = element.dataset.cancelled === "true";

                const initialPosition = delivered
                    ? routeCoordinates[routeCoordinates.length - 1]
                    : routeCoordinates[0];

                const rider = L.marker(initialPosition, {
                    icon: riderIcon,
                    zIndexOffset: 1000
                }).addTo(map).bindPopup("Demo delivery rider");

                map.fitBounds(route.getBounds(), {
                    padding: [35, 35]
                });

                const mapData = {
                    orderId: element.id.replace("delivery-map-", ""),
                    rider: rider,
                    progressLine: progressLine,
                    animationFrame: null,
                    started: started,
                    delivered: delivered,
                    cancelled: cancelled
                };

                maps[element.id] = mapData;

                if (started && !cancelled) {
                    replayRoute(mapData);
                } else if (cancelled) {
                    rider.setOpacity(0);
                }
            });

            document.querySelectorAll("[data-replay-map]").forEach(function (button) {
                button.addEventListener("click", function () {
                    const mapId = "delivery-map-" + button.dataset.replayMap;
                    const mapData = maps[mapId];

                    if (mapData) {
                        replayRoute(mapData);
                    }
                });
            });
        });
    </script>
}
