
@model LocalBite.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-page">

    <div class="auth-glass-card">

        <div class="text-center mb-4">

            <div class="auth-logo mb-3">
                LocalBite<span class="auth-gold">.</span>
            </div>

            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-3">
                JOIN THE EXPERIENCE
            </span>

            <h1 class="auth-heading">
                Create your <span class="auth-glow">account.</span>
            </h1>

            <p class="auth-subtitle mt-2">
                Great food is closer than you think.
                Let's get you started.
            </p>

        </div>

        <div class="auth-divider"></div>

        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email address
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Create password
                </label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">
                    Confirm password
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       placeholder="Enter your password again"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger small"></span>
            </div>

            <button type="submit"
                    class="btn btn-warning w-100 fw-bold">
                Create My Account →
            </button>

        </form>

        <div class="auth-divider"></div>

        <div class="text-center">

            <p class="auth-subtitle mb-2">
                Already part of LocalBite?
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="fw-bold">
                Sign in to your account
            </a>

        </div>

        <div class="text-center mt-4">
            <small class="auth-subtitle">
                Crafted for food lovers.
                <span class="auth-gold">♥</span>
            </small>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
