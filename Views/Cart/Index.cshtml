
@model List<LocalBite.Models.CartItem>

@{
    ViewData["Title"] = "Your Shopping Cart";
    var zar = System.Globalization.CultureInfo.GetCultureInfo("en-ZA");
    var total = Model.Sum(item => item.Subtotal);
}

<div class="container py-5 cart-page">

    <section class="cart-hero mb-5">
        <span class="cart-eyebrow">YOUR LOCALBITE SELECTION</span>
        <h1>Your <span>Cart.</span></h1>
        <p>Review your favourites before moving on to checkout.</p>
    </section>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-info mb-4">
            @TempData["CartMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <section class="cart-empty">
            <div class="cart-empty-icon">LB</div>
            <span class="cart-eyebrow">YOUR CART IS WAITING</span>
            <h2>Nothing delicious here yet.</h2>
            <p>Explore our menu and add something you love.</p>

            <a asp-controller="Menu"
               asp-action="Index"
               class="btn btn-warning btn-lg mt-3">
                Explore Menu →
            </a>
        </section>
    }
    else
    {
        <div class="row g-4">

            <div class="col-lg-8">

                @foreach (var item in Model)
                {
                    <article class="cart-item-card mb-3">

                        <div class="cart-item-image">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" />
                            }
                            else
                            {
                                <span>LB</span>
                            }
                        </div>

                        <div class="cart-item-details">
                            <h3>@item.Name</h3>
                            <p>@item.Price.ToString("C2", zar) each</p>

                            <div class="cart-item-actions">

                                <div class="cart-quantity-control">
                                    <span class="quantity-label">Quantity</span>

                                    <form asp-controller="Cart"
                                          asp-action="Update"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />

                                        <button type="submit"
                                                class="quantity-button"
                                                aria-label="Decrease quantity"
                                                disabled="@(item.Quantity <= 1)">
                                            −
                                        </button>
                                    </form>

                                    <span class="quantity-number">@item.Quantity</span>

                                    <form asp-controller="Cart"
                                          asp-action="Update"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />

                                        <button type="submit"
                                                class="quantity-button"
                                                aria-label="Increase quantity"
                                                disabled="@(item.Quantity >= 99)">
                                            +
                                        </button>
                                    </form>
                                </div>

                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="menuItemId" value="@item.MenuItemId" />

                                    <button type="submit" class="cart-remove-button">
                                        Remove
                                    </button>
                                </form>

                            </div>
                        </div>

                        <div class="cart-item-subtotal">
                            @item.Subtotal.ToString("C2", zar)
                        </div>

                    </article>
                }

                <form asp-controller="Cart"
                      asp-action="Clear"
                      method="post"
                      class="mt-3">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="cart-clear-button">
                        Clear Cart
                    </button>
                </form>

            </div>

            <div class="col-lg-4">

                <aside class="cart-summary">
                    <span class="cart-eyebrow">ORDER SUMMARY</span>
                    <h2>Your total</h2>

                    <div class="cart-summary-line">
                        <span>Items (@Model.Sum(item => item.Quantity))</span>
                        <strong>@total.ToString("C2", zar)</strong>
                    </div>

                    <div class="cart-summary-line">
                        <span>Delivery</span>
                        <span>Calculated at checkout</span>
                    </div>

                    <div class="cart-summary-total">
                        <span>Subtotal</span>
                        <strong>@total.ToString("C2", zar)</strong>
                    </div>

                    <a asp-controller="Checkout"
                       asp-action="Index"
                       class="checkout-button">
                        Proceed to Checkout →
                    </a>

                    <a asp-controller="Menu"
                       asp-action="Index"
                       class="cart-continue-link">
                        ← Continue Shopping
                    </a>
                </aside>

            </div>

        </div>
    }

</div>

<style>
    .cart-page {
        min-height: 65vh;
    }

    .cart-hero {
        padding: 40px;
        border-radius: 28px;
        background: linear-gradient(130deg, rgba(255,255,255,.9), rgba(220,239,255,.72));
        border: 1px solid rgba(255,255,255,.9);
        box-shadow: 0 18px 45px rgba(55,105,145,.09);
    }

    .cart-eyebrow {
        color: #347fc1;
        font-size: .7rem;
        font-weight: 850;
        letter-spacing: 1.8px;
    }

    .cart-hero h1 {
        margin: 12px 0;
        color: #203247;
        font-size: clamp(2.5rem, 5vw, 3.6rem);
        font-weight: 850;
        letter-spacing: -2px;
    }

    .cart-hero h1 span {
        color: #347fc1;
    }

    .cart-hero p {
        margin: 0;
        color: #718399;
    }

    .cart-empty {
        padding: 65px 25px;
        text-align: center;
        border-radius: 28px;
        background: rgba(255,255,255,.6);
        border: 1px solid rgba(255,255,255,.9);
        box-shadow: 0 18px 45px rgba(55,105,145,.08);
    }

    .cart-empty-icon {
        display: grid;
        place-items: center;
        width: 85px;
        height: 85px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: rgba(105,185,244,.13);
        color: #347fc1;
        font-size: 1.8rem;
        font-weight: 900;
    }

    .cart-empty h2 {
        color: #203247;
        font-weight: 850;
        margin: 12px 0;
    }

    .cart-empty p {
        color: #718399;
    }

    .cart-item-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px;
        border-radius: 24px;
        background: rgba(255,255,255,.68);
        border: 1px solid rgba(255,255,255,.95);
        box-shadow: 0 12px 35px rgba(55,105,145,.08);
        backdrop-filter: blur(20px);
    }

    .cart-item-image {
        width: 105px;
        height: 105px;
        flex-shrink: 0;
        overflow: hidden;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: #e9f1f7;
        color: #347fc1;
        font-weight: 900;
    }

    .cart-item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cart-item-details {
        flex: 1;
        min-width: 0;
    }

    .cart-item-details h3 {
        color: #203247;
        font-size: 1.05rem;
        font-weight: 850;
        margin: 0 0 5px;
    }

    .cart-item-details p {
        color: #718399;
        font-size: .85rem;
        margin-bottom: 12px;
    }

    .cart-item-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
    }

    .cart-quantity-control {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .quantity-label {
        color: #718399;
        font-size: .8rem;
        font-weight: 700;
    }

    .cart-quantity-control form {
        margin: 0;
    }

    .quantity-button {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(52,127,193,.25);
        border-radius: 10px;
        background: rgba(255,255,255,.8);
        color: #347fc1;
        font-size: 1.15rem;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

    .quantity-button:hover:not(:disabled) {
        background: #347fc1;
        color: white;
    }

    .quantity-button:disabled {
        opacity: .35;
        cursor: not-allowed;
    }

    .quantity-number {
        min-width: 18px;
        text-align: center;
        color: #203247;
        font-weight: 850;
    }

    .cart-remove-button,
    .cart-clear-button {
        border: 0;
        background: transparent;
        color: #b45a5a;
        font-size: .8rem;
        font-weight: 750;
        cursor: pointer;
    }

    .cart-item-subtotal {
        color: #347fc1;
        font-size: 1.05rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .cart-summary {
        padding: 27px;
        position: sticky;
        top: 110px;
        border-radius: 25px;
        background: rgba(255,255,255,.7);
        border: 1px solid rgba(255,255,255,.95);
        box-shadow: 0 15px 38px rgba(55,105,145,.09);
        backdrop-filter: blur(22px);
    }

    .cart-summary h2 {
        margin: 12px 0 25px;
        color: #203247;
        font-weight: 850;
    }

    .cart-summary-line,
    .cart-summary-total {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 0;
        color: #718399;
        font-size: .85rem;
    }

    .cart-summary-line strong {
        color: #203247;
    }

    .cart-summary-total {
        margin-top: 10px;
        border-top: 1px solid rgba(117,159,193,.25);
        color: #203247;
        font-weight: 800;
    }

    .cart-summary-total strong {
        color: #347fc1;
        font-size: 1.35rem;
    }

    .checkout-button {
        display: block;
        width: 100%;
        margin-top: 20px;
        padding: 15px;
        border: none;
        border-radius: 15px;
        background: linear-gradient(110deg, #2869c7, #d3a443);
        color: white;
        text-align: center;
        text-decoration: none;
        font-weight: 800;
        transition: transform .2s, box-shadow .2s;
    }

    .checkout-button:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(40,105,199,.2);
    }

    .cart-continue-link {
        display: block;
        margin-top: 20px;
        color: #347fc1;
        text-align: center;
        font-size: .85rem;
        font-weight: 750;
        text-decoration: none;
    }

    @@media (max-width: 576px) {
        .cart-hero {
            padding: 28px 22px;
        }

        .cart-item-card {
            flex-wrap: wrap;
            gap: 13px;
        }

        .cart-item-image {
            width: 85px;
            height: 85px;
        }

        .cart-item-subtotal {
            width: 100%;
            text-align: right;
        }

        .cart-summary {
            position: static;
        }
    }
</style>
